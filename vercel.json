{
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "env": {},
  "regions": ["auto"],
  "functions": {
    "*.html": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    }
  ],
  "redirects": [],
  "rewrites": [],
  "cleanUrls": true
}
